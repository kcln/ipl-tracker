<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kcln.ipl-ml-retrain</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO_PATH__/ml/.venv/bin/python</string>
        <string>-m</string>
        <string>ml.scripts.nightly_retrain</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_PATH__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <!-- Fires 02:00 PT daily. After the 18:00 cricsheet refresh.
         If the system was asleep at 02:00 launchd catches up on next wake;
         if it was off entirely launchd fires the job on next login. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/ipl-ml-retrain.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/ipl-ml-retrain.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
