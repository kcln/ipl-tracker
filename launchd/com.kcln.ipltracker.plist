<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kcln.ipltracker</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO_PATH__/venv/bin/python3</string>
        <string>__REPO_PATH__/src/tracker.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_PATH__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>IMESSAGE_RECIPIENT</key>
        <string>__IMESSAGE_RECIPIENT__</string>
        <key>CRICAPI_KEY</key>
        <string>__CRICAPI_KEY__</string>
        <key>SHEET_SYNC_TOKEN</key>
        <string>__SHEET_SYNC_TOKEN__</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StartInterval</key>
    <integer>900</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/ipl-tracker.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/ipl-tracker.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
